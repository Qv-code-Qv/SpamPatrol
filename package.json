{
  "name": "spam-patrol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend --legacy-peer-deps",
    "start:back": "npm run dev --prefix backend",
    "start:front": "npm start --prefix frontend",
    "start-all": "concurrently -k \"npm run start:back\" \"npm run start:front\"",
    "start": "npm run start-all",
    "test:back": "npm test --prefix backend",
    "test:front": "npm test --prefix frontend",
    "test": "npm run test:back && npm run test:front",
    "build:front": "npm run build --prefix frontend",
    "arcep:update": "npm run arcep:update --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
